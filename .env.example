# Copy to .env and fill in; Docker Compose reads .env automatically

# The stack pulls `ghcr.io/xenago/syncovery-container:latest` by default.
# Pin a specific version, or build locally:
#SYNCOVERY_IMAGE=ghcr.io/xenago/syncovery-container:11.16.4
#SYNCOVERY_IMAGE=syncovery-container:local

# Store persistent data at an absolute path (default: ./data beside the compose file):
#SC_DATA_DIR=/srv/syncovery/data

# Timezone applied to the container and logs:
#TZ=Etc/UTC

# Host port bindings
# Each defaults to localhost only (127.0.0.1:<port>), reachable from the Docker host but not the wider network
# Put a reverse proxy in front for remote access (see examples/nginx-proxy.conf)
# To reach it from elsewhere, bind a specific host interface e.g. SC_WEB_PORT=192.168.1.50:8999, or just the port number to expose on all interfaces
# Uncomment SC_HTTPS_PORT / SC_CLOUD_PORT / SC_REMOTE_PORT in docker-compose.yml to publish those ports as well.
#SC_WEB_PORT=127.0.0.1:8999
#SC_HTTPS_PORT=127.0.0.1:8943
#SC_CLOUD_PORT=127.0.0.1:8889
#SC_REMOTE_PORT=127.0.0.1:8949

# Advanced: disable bundled services
#SC_SERVICE_SYNCOVERY=1
#SC_SERVICE_RSYSLOG=1
